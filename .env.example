# kappa-registry environment configuration
# Loaded by direnv as operational defaults. Override in .env (gitignored).

# =============================================================================
# Server
# =============================================================================
# Listen address (host:port)
KAPPA_LISTEN_ADDR=127.0.0.1:8080

# =============================================================================
# Storage
# =============================================================================
# Root directory for the filesystem store
KAPPA_STORE_ROOT=./data

# =============================================================================
# Limits
# =============================================================================
# Maximum blob size in bytes (64 MiB)
KAPPA_MAX_BLOB_SIZE=67108864

# Upload session timeout in seconds
KAPPA_UPLOAD_TIMEOUT=3600

# =============================================================================
# Rate Limiting (tiered, per-IP via GCRA token bucket)
# =============================================================================
# Each operation class has its own token bucket per client IP.
# period_ms = token refill interval (0 = disabled for that class).
# burst = maximum burst capacity before limiting kicks in.
# Sustained rate = 1000 / period_ms requests per second.
#
# Read: GET/HEAD on blobs, manifests, tags, edges, referrers, schemas.
KAPPA_RATELIMIT_READ_PERIOD_MS=10
KAPPA_RATELIMIT_READ_BURST=1000
#
# Write: PUT/POST/PATCH on blobs, manifests, tags, edges, uploads, compose.
KAPPA_RATELIMIT_WRITE_PERIOD_MS=50
KAPPA_RATELIMIT_WRITE_BURST=200
#
# Admin: DELETE, GC, transactions, reconcile.
KAPPA_RATELIMIT_ADMIN_PERIOD_MS=200
KAPPA_RATELIMIT_ADMIN_BURST=50
#
# Health (/v2/, /v2/_health/*) is always exempt from rate limiting.

# =============================================================================
# Transactions
# =============================================================================
# Maximum concurrent multi-object transactions
KAPPA_MAX_TRANSACTIONS=64

# Maximum total bytes across all active staging directories (256 MiB)
KAPPA_MAX_STAGING_BYTES=268435456
